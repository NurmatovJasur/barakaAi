# ---------- API (apps/api reads ../../.env) ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://smp:smp_local_password@localhost:5433/smart_market_prices?schema=public
TEST_DATABASE_URL=postgresql://smp:smp_local_password@localhost:5433/smart_market_prices_test?schema=public

# DEV_MODE=true enables POST /api/auth/dev (test login without Telegram). Never enable in production.
DEV_MODE=true

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Telegram bot token from @BotFather. Server-side only — never expose to the frontend.
TELEGRAM_BOT_TOKEN=
# Max age of Telegram initData in seconds
TELEGRAM_INITDATA_MAX_AGE=86400

# Allowed web origins (comma separated)
WEB_ORIGIN=http://localhost:5173

# Offer freshness policy (hours)
FRESHNESS_FRESH_HOURS=24
FRESHNESS_STALE_HOURS=72

# Optimizer compute budget (max candidate evaluations per run)
OPTIMIZER_MAX_EVALUATIONS=200000

# ---------- Web (apps/web reads VITE_* from ../../.env) ----------
VITE_API_URL=/api
VITE_DEV_MODE=true

# ---------- Bot (apps/bot) ----------
# Public HTTPS URL where the web app is served (e.g. ngrok / Vercel)
WEB_APP_URL=https://example.com

# Auth requests per minute per IP. Keep 20 in production; raise locally for E2E runs.
AUTH_RATE_LIMIT=20
# All API requests per 15 min per IP. Keep 600 in production.
API_RATE_LIMIT=600
