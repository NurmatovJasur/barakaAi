generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unit {
  KG
  L
  PCS
  PACK
  DOZEN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  OUT_OF_STOCK
}

enum DataQualityStatus {
  VALID
  WARNING
  INVALID
  EXPIRED
}

enum PurchaseStatus {
  DRAFT
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OptimizationStatus {
  OPTIMAL
  FEASIBLE_LIMIT_REACHED
  INFEASIBLE
}

enum ScenarioKind {
  SINGLE
  MULTI
  BALANCED_2
  BALANCED_3
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  telegramId BigInt   @unique
  firstName  String?
  lastName   String?
  username   String?
  photoUrl   String?
  isDevUser  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business?
  basket           Basket?
  purchases        Purchase[]
  reviews          Review[]
  optimizationRuns OptimizationRun[]
  notifications    Notification[]
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String
  type      String?
  district  String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  categoryId  String   @db.Uuid
  unit        Unit
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        ProductCategory          @relation(fields: [categoryId], references: [id])
  offers          SupplierOffer[]
  basketItems     BasketItem[]
  purchaseItems   PurchaseItem[]
  allocations     OptimizationAllocation[]

  @@index([categoryId])
  @@index([isActive, name])
}

model Supplier {
  id                 String             @id @default(uuid()) @db.Uuid
  companyName        String             @unique
  description        String?
  contactPerson      String?
  phone              String?
  email              String?
  telegramUsername   String?
  address            String?
  district           String
  deliveryZones      String[]
  rating             Decimal?           @db.Decimal(3, 2)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isActive           Boolean            @default(true)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  offers        SupplierOffer[]
  reviews       Review[]
  metrics       SupplierMetrics?
  purchaseItems PurchaseItem[]
  allocations   OptimizationAllocation[]

  @@index([isActive])
}

model SupplierOffer {
  id                    String             @id @default(uuid()) @db.Uuid
  supplierId            String             @db.Uuid
  productId             String             @db.Uuid
  price                 Decimal            @db.Decimal(14, 2)
  currency              String             @default("UZS")
  unit                  Unit
  minOrderQuantity      Decimal            @db.Decimal(12, 3)
  availableQuantity     Decimal            @db.Decimal(12, 3)
  deliveryCost          Decimal            @db.Decimal(14, 2)
  deliveryZones         String[]
  estimatedDeliveryDays Int                @default(1)
  lastUpdated           DateTime           @default(now())
  expiresAt             DateTime?
  availabilityStatus    AvailabilityStatus @default(AVAILABLE)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  dataQualityStatus     DataQualityStatus  @default(VALID)
  dataQualityNotes      String[]           @default([])
  isDemo                Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  supplier     Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]
  allocations  OptimizationAllocation[]

  @@unique([supplierId, productId, unit, currency])
  @@index([productId])
  @@index([supplierId])
  @@index([lastUpdated])
}

model PriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @db.Uuid
  productId  String   @db.Uuid
  supplierId String   @db.Uuid
  price      Decimal  @db.Decimal(14, 2)
  currency   String
  unit       Unit
  recordedAt DateTime @default(now())
  isDemo     Boolean  @default(false)

  offer SupplierOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
  @@index([productId, recordedAt])
}

model Basket {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BasketItem[]
}

model BasketItem {
  id        String   @id @default(uuid()) @db.Uuid
  basketId  String   @db.Uuid
  productId String   @db.Uuid
  quantity  Decimal  @db.Decimal(12, 3)
  unit      Unit
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  basket  Basket  @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([basketId, productId])
}

model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  status            PurchaseStatus @default(DRAFT)
  scenario          ScenarioKind?
  optimizationRunId String?        @unique @db.Uuid
  productsCost      Decimal        @db.Decimal(14, 2)
  deliveryCost      Decimal        @db.Decimal(14, 2)
  totalCost         Decimal        @db.Decimal(14, 2)
  baselineCost      Decimal?       @db.Decimal(14, 2)
  estimatedSavings  Decimal?       @db.Decimal(14, 2)
  note              String?
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  optimizationRun OptimizationRun? @relation(fields: [optimizationRunId], references: [id])
  items           PurchaseItem[]

  @@index([userId, createdAt])
}

model PurchaseItem {
  id         String  @id @default(uuid()) @db.Uuid
  purchaseId String  @db.Uuid
  productId  String  @db.Uuid
  supplierId String  @db.Uuid
  unit       Unit
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(14, 2)
  totalPrice Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([purchaseId])
  @@index([supplierId])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  userId     String?  @db.Uuid
  authorName String
  rating     Int
  comment    String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([supplierId, createdAt])
}

model SupplierMetrics {
  id                  String   @id @default(uuid()) @db.Uuid
  supplierId          String   @unique @db.Uuid
  completedOrders     Int      @default(0)
  cancelledOrders     Int      @default(0)
  onTimeDeliveries    Int      @default(0)
  totalDeliveries     Int      @default(0)
  priceMatchedOrders  Int      @default(0)
  priceCheckedOrders  Int      @default(0)
  isDemo              Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model OptimizationRun {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  deliveryDistrict String?
  request          Json
  result           Json
  status           OptimizationStatus
  recommended      ScenarioKind?
  evaluations      Int
  createdAt        DateTime           @default(now())

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations OptimizationAllocation[]
  purchase    Purchase?

  @@index([userId, createdAt])
}

model OptimizationAllocation {
  id         String       @id @default(uuid()) @db.Uuid
  runId      String       @db.Uuid
  scenario   ScenarioKind
  productId  String       @db.Uuid
  supplierId String       @db.Uuid
  offerId    String       @db.Uuid
  unit       Unit
  quantity   Decimal      @db.Decimal(12, 3)
  unitPrice  Decimal      @db.Decimal(14, 2)
  totalPrice Decimal      @db.Decimal(14, 2)

  run      OptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  offer    SupplierOffer   @relation(fields: [offerId], references: [id])

  @@index([runId, scenario])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
