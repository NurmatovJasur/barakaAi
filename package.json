{
  "name": "smart-market-prices",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smart Market Prices — procurement optimization Telegram Mini App",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @smp/api\" \"npm run dev -w @smp/web\"",
    "dev:bot": "npm run dev -w @smp/bot",
    "db:start": "npm run db:start -w @smp/api",
    "db:up": "docker compose up -d",
    "db:deploy": "npm run db:deploy -w @smp/api",
    "db:migrate": "npm run db:migrate -w @smp/api",
    "db:seed": "npm run db:seed -w @smp/api",
    "db:reset": "npm run db:reset -w @smp/api",
    "test": "npm run test -w @smp/api && npm run test -w @smp/web",
    "test:e2e": "npm run test:e2e -w @smp/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.6.0-beta.15": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
